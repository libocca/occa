{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "OCCA configure base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "OCCA_ENABLE_OPENMP": "ON",
        "OCCA_ENABLE_OPENCL": "ON",
        "OCCA_ENABLE_DPCPP": "OFF",
        "OCCA_ENABLE_CUDA": "ON",
        "OCCA_ENABLE_HIP": "ON",
        "OCCA_ENABLE_METAL": "OFF",
        "OCCA_ENABLE_FORTRAN": "ON",
        "OCCA_ENABLE_TESTS": "ON",
        "OCCA_ENABLE_EXAMPLES": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
        "CMAKE_C_COMPILER": "$env{CC}",
        "CMAKE_CXX_COMPILER": "$env{CXX}",
        "CMAKE_Fortran_COMPILER": "$env{FC}",
        "CMAKE_CXX_FLAGS": "-O3 -Wall -pedantic -Wshadow -Wsign-compare -Wuninitialized -Wtype-limits -Wignored-qualifiers -Wempty-body -Wextra -Wno-unused-parameter -Werror -Wno-strict-aliasing $env{CXXFLAGS}"
      }
    },
    {
      "name": "system-default",
      "description": "OCCA configure with system default compilers",
      "inherits": "base",
      "environment": {
        "CC": "$penv{CC}",
        "CXX": "$penv{CXX}",
        "FC": "$penv{FC}"
      }
    },
    {
      "name": "gnu-default",
      "description": "OCCA configure with GNU compilers",
      "inherits": "base",
      "environment": {
        "CC": "gcc",
        "CXX": "g++",
        "FC": "gfortran",
        "CXXFLAGS": "-Wno-maybe-uninitialized -Wno-cpp"
      }
    },
    {
      "name": "clang-default",
      "description": "OCCA configure with LLVM/Clang compilers",
      "inherits": "base",
      "cacheVariables": {
        "OCCA_ENABLE_FORTRAN": "OFF"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++",
        "CXXFLAGS": "-Wno-uninitialized"
      }
    },
    {
      "name": "oneapi-default",
      "description": "OCCA configure with oneAPI compilers",
      "inherits": "base",
      "cacheVariables": {
        "OCCA_ENABLE_DPCPP": "ON"
      },
      "environment": {
        "CC": "icx",
        "CXX": "icpx",
        "FC": "ifx",
        "CXXFLAGS": "-Wno-uninitialized"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "system-default",
      "description": "OCCA build with system default compilers",
      "configurePreset": "system-default",
      "targets": ["install"],
      "jobs": 8
    },
    {
      "name": "gnu-default",
      "description": "OCCA build with GNU compilers",
      "inherits": "system-default",
      "configurePreset": "gnu-default"
    },
    {
      "name": "clang-default",
      "description": "OCCA build with LLVM/Clang compilers",
      "inherits": "system-default",
      "configurePreset": "clang-default"
    },
    {
      "name": "oneapi-default",
      "description": "OCCA build with oneAPI compilers",
      "inherits": "system-default",
      "configurePreset": "oneapi-default"
    }
  ],
  "testPresets": [
    {
      "name": "system-default",
      "displayName": "Run tests with system default compilers",
      "configurePreset": "system-default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false
      },
      "filter": {
        "exclude": {
          "name": "examples_cpp_arrays-opencl|examples_cpp_for_loops-opencl|examples_cpp_generic_inline_kernel-opencl|examples_cpp_shared_memory-opencl|examples_cpp_nonblocking_streams-opencl|examples_cpp_for_loops-dpcpp|examples_cpp_arrays-dpcpp|examples_cpp_generic_inline_kernel-dpcpp|examples_cpp_nonblocking_streams-dpcpp"
        }
      }
    },
    {
      "name": "clang-default",
      "displayName": "Run tests with LLVM/Clang compilers",
      "inherits": "system-default",
      "configurePreset": "clang-default"
    },
    {
      "name": "gnu-default",
      "displayName": "Run tests with GNU compilers",
      "inherits": "system-default",
      "configurePreset": "gnu-default"
    },
    {
      "name": "oneapi-default",
      "displayName": "Run tests with oneAPI compilers",
      "inherits": "system-default",
      "configurePreset": "oneapi-default",
      "filter": {
        "exclude": {
          "name": "opencl-*|dpcpp-*"
        }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "system-default",
      "displayName": "Configure, build and install with system default compilers",
      "steps": [
        {
          "type": "configure",
          "name": "system-default"
        },
        {
          "type": "build",
          "name": "system-default"
        },
        {
          "type": "test",
          "name": "system-default"
        }
      ]
    },
    {
      "name": "gnu-default",
      "displayName": "Configure, build and install with GNU compilers",
      "steps": [
        {
          "type": "configure",
          "name": "gnu-default"
        },
        {
          "type": "build",
          "name": "gnu-default"
        },
        {
          "type": "test",
          "name": "gnu-default"
        }
      ]
    },
    {
      "name": "clang-default",
      "displayName": "Configure, build and install with LLVM/Clang compilers",
      "steps": [
        {
          "type": "configure",
          "name": "clang-default"
        },
        {
          "type": "build",
          "name": "clang-default"
        },
        {
          "type": "test",
          "name": "clang-default"
        }
      ]
    },
    {
      "name": "oneapi-default",
      "displayName": "Configure, build and install with oneAPI compilers",
      "steps": [
        {
          "type": "configure",
          "name": "oneapi-default"
        },
        {
          "type": "build",
          "name": "oneapi-default"
        },
        {
          "type": "test",
          "name": "oneapi-default"
        }
      ]
    }
  ]
}
